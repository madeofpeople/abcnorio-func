{
  "name": "@abcnorio/custom-func",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "ingest:components": "bash scripts/ingest-components-dist.sh",
    "copy:calendar": "mkdir -p build/calendar && cp node_modules/fullcalendar/index.global.min.js build/calendar/fullcalendar.min.js && cp node_modules/@fullcalendar/icalendar/index.global.min.js build/calendar/icalendar.min.js && cp node_modules/ical.js/build/ical.min.js build/calendar/ical.min.js",
    "build": "npm run ingest:components && wp-scripts build resources/js/index.js --output-path=build && npm run copy:calendar",
    "start": "wp-scripts start resources/js/index.js --output-path=build"
  },
  "devDependencies": {
    "@fullcalendar/icalendar": "^6.1.22",
    "@wordpress/browserslist-config": "^6.33.0",
    "@wordpress/element": "^6.33.0",
    "@wordpress/plugins": "^7.33.0",
    "@wordpress/scripts": "^31.7.0",
    "fullcalendar": "^6.1.22",
    "ical.js": "^1.5.0",
    "jsdoc": "^4.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.89.2",
    "standard-version": "^9.5.0"
  },
  "overrides": {
    "axios": "^1.15.2",
    "serialize-javascript": "^7.0.5",
    "webpack-dev-server": "^5.2.2",
    "minimatch": "^9.0.7"
  },
  "dependencies": {
    "abcnorio-webcomponents": "github:madeofpeople/abcnorio-webcomponents#main",
    "select2": "github:woocommerce/selectWoo"
  },
  "allowScripts": {
    "github:madeofpeople/abcnorio-webcomponents#9907a2a39acf38508f12c48cfe89e64dac9cb667": true
  }
}
