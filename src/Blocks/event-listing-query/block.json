{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "abcnorio/event-listing",
  "title": "Event Listing Block",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "Lists events matching configured criteria.",
  "keywords": ["events", "listing", "abcnorio"],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "dateFilter": {
      "type": "string",
      "default": "upcoming"
    },
    "collectiveAssociation": {
      "type": "string",
      "default": ""
    },
    "eventType": {
      "type": "string",
      "default": ""
    },
    "order": {
      "type": "string",
      "default": "desc"
    },
    "variant": {
      "type": "string",
      "default": "grid"
    },
    "gridColumns": {
      "type": "string",
      "default": ""
    },
    "itemCount": {
      "type": "number",
      "default": 6
    },
    "slidesPerPage": {
      "type": "number",
      "default": 1
    },
    "slidesPerPageXs": {
      "type": "number",
      "default": 2
    },
    "slidesPerPageSm": {
      "type": "number",
      "default": 3
    },
    "slidesPerPageMd": {
      "type": "number",
      "default": 4
    },
    "slidesPerPageLg": {
      "type": "number",
      "default": 3.5
    },
    "showAllLink": {
      "type": "boolean",
      "default": true
    },
    "showAllLinkHref": {
      "type": "string",
      "default": "/events/"
    },
    "showAllLinkLabel": {
      "type": "string",
      "default": "View all"
    },
    "showCount": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "align": false,
    "html": false
  }
}