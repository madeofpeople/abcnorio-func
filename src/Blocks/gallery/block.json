{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "abcnorio/gallery",
  "title": "ABCNorio Gallery",
  "category": "media",
  "icon": "images-alt2",
  "description": "Gallery block with preview parity and page navigation.",
  "keywords": ["gallery", "images", "abcnorio"],
  "attributes": {
    "variant": {
      "type": "string",
      "default": "slider"
    },
    "itemsPerPage": {
      "type": "number",
      "default": 8
    },
    "allowResize": {
      "type": "boolean",
      "default": false
    }
  },
  "providesContext": {
    "allowResize": "allowResize"
  },
  "supports": {
    "align": false,
    "html": false
  }
}